"""Scan atlas/toolchain for prohibited imports (kernel, runtime, gateway, dispatcher, scheduler, events, ai)."""

from __future__ import annotations

import ast
import sys
from pathlib import Path

PROHIBITED = (
    "atlas.kernel",
    "atlas.runtime",
    "atlas.gateway",
    "atlas.dispatcher",
    "atlas.scheduler",
    "atlas.events",
    "atlas.ai",
)

root = Path("atlas/toolchain")
violations: list[str] = []

for path in sorted(root.rglob("*.py")):
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    except Exception as exc:
        violations.append(f"{path}: PARSE ERROR {exc}")
        continue
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith(PROHIBITED):
                    violations.append(f"{path}: import {alias.name} (line {node.lineno})")
        elif isinstance(node, ast.ImportFrom) and node.module:
            if node.module.startswith(PROHIBITED):
                violations.append(f"{path}: from {node.module} import ... (line {node.lineno})")

if violations:
    print("PROHIBITED IMPORTS FOUND:")
    for v in sorted(violations):
        print(f"  {v}")
    sys.exit(1)

print("OK: no prohibited imports (kernel/runtime/gateway/dispatcher/scheduler/events/ai) in atlas/toolchain")
