# Atlas Environment Configuration
# Copy this file to .env and fill in your values.

# AI Provider Selection
# Supported: Ollama, OpenAI, Anthropic, LM Studio
ATLAS_AI_PROVIDER=Ollama
ATLAS_AI_MODEL=qwen3:8b
ATLAS_AI_TEMPERATURE=0.7
ATLAS_AI_TIMEOUT=300

# OpenAI API Key (required for OpenAI provider)
OPENAI_API_KEY=

# Anthropic API Key (required for Anthropic provider)
ANTHROPIC_API_KEY=

# LM Studio Base URL (optional, defaults to http://localhost:1234/v1)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Conversation
ATLAS_CONVERSATION_HISTORY_LIMIT=20

# Logging
ATLAS_LOG_LEVEL=INFO